[Unit]
Description=OpenAI-Compat-Gateway (TAKAGO LAB)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=openai-gateway
Group=openai-gateway
WorkingDirectory=/opt/openai-compat-gateway
Environment=GATEWAY_DB=/var/lib/openai-compat-gateway/gateway.sqlite3
ExecStart=/opt/openai-compat-gateway/.venv/bin/uvicorn gateway:app --host 127.0.0.1 --port 8765
StateDirectory=openai-compat-gateway
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
