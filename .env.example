GATEWAY_CONFIG=config.json
GATEWAY_DB=gateway.sqlite3
# Bootstrap key: imported once at initial database creation. Rotate/disable from admin UI.
GATEWAY_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_API_KEY
# Generate with: python setup_admin.py
ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
# Generate a random value: python -c 'import secrets; print(secrets.token_urlsafe(48))'
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Keep true behind HTTPS Caddy; for HTTP localhost testing only set false.
ADMIN_COOKIE_SECURE=true
# BACKEND_VIDEO_KEY=your_backend_specific_key
